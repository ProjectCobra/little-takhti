{
  "appId": "app.littletakhti",
  "appName": "Little Takhti",
  "webDir": "www",
  "backgroundColor": "#FFFFFF",
  "android": {
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "ios": {
    "contentInset": "always"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#FFFFFF",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#123B28",
      "overlaysWebView": false
    }
  }
}