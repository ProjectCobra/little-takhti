rules_version = '2';
// Little Takhti: Firestore security rules. Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email_verified == true
      && request.auth.token.email in ['sumbulaftab@gmail.com']; }
    function notBanned() { return !signedIn() || !exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }
    function str(v, max) { return v is string && v.size() <= max; }

    // each family's private profiles, children and quiz progress
    match /data/users/{uid}/{rest=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // one summary row per signed-in family, used for counts in the admin site
    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid && notBanned()
        && request.resource.data.keys().hasOnly(['name','email','photo','joined','lastSeen','role','city','province','kids','kidsN','updated'])
        && request.resource.data.kids is list && request.resource.data.kids.size() <= 12;
      allow delete: if isAdmin();
    }

    // daily usage counters; visitors may only add to known counters
    match /stats/{day} {
      allow read, delete: if isAdmin();
      allow create, update: if day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['pv','uv','nv','help','share','mod','ws','pr','dl','qz','pu','gm','st','dev','gr']);
    }

    // help desk messages: anyone can send, only the owner can read
    match /help/{id} {
      allow create: if notBanned()
        && request.resource.data.keys().hasOnly(['type','where','message','email','uid','name','page','rid','grade','attachments','status','device','agree','createdAt','updated'])
        && str(request.resource.data.message, 3000) && request.resource.data.message.size() >= 10
        && str(request.resource.data.where, 140) && str(request.resource.data.email, 120)
        && request.resource.data.status == 'new' && request.resource.data.agree == true
        && request.resource.data.attachments is list && request.resource.data.attachments.size() <= 5
        && (request.resource.data.uid == '' || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read, update, delete: if isAdmin();
      // small picture copies, used only if file storage is unavailable
      match /files/{n} {
        allow create: if notBanned() && n in ['0','1','2'] && str(request.resource.data.data, 700000)
          && request.resource.data.data.matches('^data:image/jpeg;base64,.*');
        allow read, delete: if isAdmin();
      }
    }

    // teaching material shared by signed-in families and teachers
    match /submissions/{id} {
      allow create: if signedIn() && notBanned() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.agree == true
        && str(request.resource.data.title, 100) && str(request.resource.data.desc, 1200)
        && request.resource.data.files is list && request.resource.data.files.size() >= 1 && request.resource.data.files.size() <= 5;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // blocked accounts
    match /banned/{uid} {
      allow read, write: if isAdmin();
    }

    // anything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
